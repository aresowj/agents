# Copy to config.env to override install defaults.
# config.env is gitignored for machine-specific paths.

# Display name in Cursor Cloud Agents (Slack/GitHub: worker=<name>)
WORKER_NAME=kagami-mac-mini

# Repository root exposed to the worker. Defaults to the repo containing these scripts.
# WORKER_DIR=/Users/you/agents

# Path to the Cursor CLI. Defaults to `command -v agent` or ~/.local/bin/agent.
# AGENT_BIN=/Users/you/.local/bin/agent
